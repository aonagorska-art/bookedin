{
  "name": "bookedin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --import tsx --watch backend/server.ts",
    "build": "node scripts/generate-notices.mjs && tsc -b && vite build",
    "licenses": "node scripts/generate-notices.mjs",
    "start": "node --import tsx backend/server.ts",
    "test": "node --import tsx --test backend/**/*.test.ts",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cheerio": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "node-cron": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "packageManager": "pnpm@11.25.0"
}
